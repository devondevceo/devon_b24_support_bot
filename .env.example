# Скопировать в .env и заполнить. .env НИКОГДА не коммитится (см. .gitignore).

# --- домен и публичный адрес ------------------------------------------------
DOMAIN=b24sdbot.devondev.ru
PUBLIC_BASE_URL=https://b24sdbot.devondev.ru
# Ставить true ТОЛЬКО после того, как A-запись домена реально резолвится.
# Иначе Traefik зациклится на неудачном выпуске сертификата и упрётся в лимит
# Let's Encrypt: 5 неудачных валидаций на домен в час.
TRAEFIK_ENABLE=false

# --- база данных ------------------------------------------------------------
POSTGRES_DB=b24sdbot
POSTGRES_USER=b24sdbot
POSTGRES_PASSWORD=
# для приложения и alembic (хост = имя сервиса в compose)
DATABASE_URL=postgresql://b24sdbot:@b24sdbot-postgres:5432/b24sdbot

# --- шифрование секретов ----------------------------------------------------
# 32 байта в base64url. Сгенерировать:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_KEY=
MASTER_KEY_ID=1

# --- OAuth-приложение Битрикс24 ---------------------------------------------
# Выдаются при регистрации локального приложения на портале.
# «Код приложения» и «Ключ приложения».
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Передавать ли собственный redirect_uri на экран согласия портала при привязке
# из Telegram (/link). По умолчанию НЕТ: у локального приложения обработчик один,
# документация разрешает параметр не слать, а незарегистрированный адрес портал
# вправе отвергнуть — и тогда привязка не начнётся вовсе. Включать ТОЛЬКО после
# того, как https://<домен>/b24/oauth/callback прописан обработчиком приложения
# на портале и проверен живым входом (docs/50-web-and-b24-app.md §2.10).
B24_OAUTH_REDIRECT=false

# --- мини-апп ---------------------------------------------------------------
# Живёт по пути PUBLIC_BASE_URL/miniapp — отдельный домен не нужен.
# Кнопку в меню бота ставит само приложение при подключении бота, руками ничего
# делать не надо. Переменная ниже — запасное короткое имя из BotFather
# (`/newapp`): с ним мини-апп открывается из группового чата в одно касание,
# без него — через личку бота. Своё значение теннанта хранится в БД и главнее.
MINIAPP_SHORT_NAME=
# Где в контейнере лежит собранный фронтенд. Менять незачем.
MINIAPP_DIST=/app/web/miniapp

# Спайк-режим SPIKE_LOG_PAYLOADS удалён вместе с таблицей b24_payload_log
# (миграция 0019): формат входящих запросов зафиксирован в docs/00-portal-facts.md,
# журнал вызовов ведёт b24_call_log. Строка в боевом .env безвредна и игнорируется.

# Второй рубеж изоляции теннантов: соединения приложения объявляют RLS-enforce.
# Политики (миграция 0020) без этого инертны. Включать по docs/80-deploy.md §9 —
# отдельным шагом после выкатки, не вместе с ней, И ТОЛЬКО вместе со сменой
# пользователя в DATABASE_URL на роль b24bot_app: bootstrap-пользователь
# postgres — суперпользователь, а суперпользователя row security не касается.
# В CI включено всегда (conftest ходит ролью b24bot_app сам).
RLS_ENFORCE=false
# При включённом RLS приложение ходит ролью без DDL-прав, а миграциям нужен
# владелец: alembic берёт этот URL первым, без него — DATABASE_URL как раньше.
# MIGRATIONS_DATABASE_URL=postgresql://b24sdbot:...@postgres:5432/b24sdbot

LOG_LEVEL=INFO

# --- временно, только на время спайков --------------------------------------
# Входящий вебхук портала. Отозвать после перехода на OAuth-приложение.
B24_WEBHOOK_URL=

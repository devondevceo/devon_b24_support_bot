# Скопировать в .env и заполнить. .env НИКОГДА не коммитится (см. .gitignore).

# --- домен и публичный адрес ------------------------------------------------
DOMAIN=b24sdbot.devondev.ru
PUBLIC_BASE_URL=https://b24sdbot.devondev.ru
# Ставить true ТОЛЬКО после того, как A-запись домена реально резолвится.
# Иначе Traefik зациклится на неудачном выпуске сертификата и упрётся в лимит
# Let's Encrypt: 5 неудачных валидаций на домен в час.
TRAEFIK_ENABLE=false

# --- база данных ------------------------------------------------------------
POSTGRES_DB=b24sdbot
POSTGRES_USER=b24sdbot
POSTGRES_PASSWORD=
# для приложения и alembic (хост = имя сервиса в compose)
DATABASE_URL=postgresql://b24sdbot:@b24sdbot-postgres:5432/b24sdbot

# --- шифрование секретов ----------------------------------------------------
# 32 байта в base64url. Сгенерировать:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MASTER_KEY=
MASTER_KEY_ID=1

# --- OAuth-приложение Битрикс24 ---------------------------------------------
# Выдаются при регистрации локального приложения на портале.
# «Код приложения» и «Ключ приложения».
B24_CLIENT_ID=
B24_CLIENT_SECRET=

# --- спайк-режим ------------------------------------------------------------
# Логировать структуру входящих payload от Битрикса (значения секретов маскируются).
# Выключить после завершения SPIKE A.
SPIKE_LOG_PAYLOADS=true

LOG_LEVEL=INFO

# --- временно, только на время спайков --------------------------------------
# Входящий вебхук портала. Отозвать после перехода на OAuth-приложение.
B24_WEBHOOK_URL=
